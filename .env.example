AEVO_ENVIRONMENT=development
AEVO_BUILD_VERSION=local
AEVO_DATABASE_URL=
# Keep one Core connection available for the first authenticated request.
AEVO_DATABASE_POOL_MIN_SIZE=4
AEVO_DATABASE_POOL_MAX_SIZE=100
AEVO_DATABASE_WARMUP=true
AEVO_DATABASE_WARMUP_CONNECTIONS=4
AEVO_DATABASE_WARMUP_TIMEOUT_SECONDS=5
AEVO_IDENTITY_PLATFORM_PROJECT_ID=
AEVO_ACCOUNTS_API_ORIGIN=http://127.0.0.1:8787
# Local-only values; use separate managed secrets outside local development.
AEVO_ACCOUNTS_SERVICE_SECRET=aevo-local-accounts-service-secret
AEVO_CORE_API_SERVICE_SECRET=aevo-local-core-service-secret
AEVO_SESSION_SECRET=replace-with-a-long-random-session-secret
AEVO_AUDIT_CURSOR_SECRET=replace-with-a-long-random-audit-cursor-secret
AEVO_RECOVERY_GRANT_ENCRYPTION_KEY=replace-with-a-separate-recovery-encryption-secret
AEVO_HUB_WEB_ORIGIN=http://localhost:4330
# Comma-separated browser origins allowed to perform authenticated mutations.
AEVO_ALLOWED_ORIGINS=http://localhost:4330,http://localhost:4331,http://localhost:4332,http://localhost:4324,http://localhost:4335
AEVO_PLACE_CURSOR_SECRET=replace-with-a-long-random-place-cursor-secret
AEVO_ALLOW_LEGACY_HARD_DELETE=false
AEVO_ALLOW_LEGACY_FAVORITE_RECONCILIATION=false
AEVO_ALLOW_LEGACY_FAVORITE_HARD_DELETE=false
AEVO_PLACE_PROJECTION_REPLAY_TOKEN=
AEVO_ALLOW_PLACE_PROJECTION_REPLAY=false
AEVO_PLACE_REFERENCE_RESOLUTION=false
AEVO_SESSION_COOKIE_NAMES=HUB=aevo_hub_session,ADMIN=aevo_admin_session,GO=aevo_go_session,PLAY=aevo_play_session,POS=aevo_pos_session,KIOSK=aevo_kiosk_session,QUEUE=aevo_queue_session,DIGITAL_SIGN=aevo_digital_sign_session
AEVO_CSRF_COOKIE_NAMES=HUB=aevo_csrf,ADMIN=aevo_admin_csrf,GO=aevo_go_csrf,PLAY=aevo_play_csrf,POS=aevo_pos_csrf,KIOSK=aevo_kiosk_csrf,QUEUE=aevo_queue_csrf,DIGITAL_SIGN=aevo_digital_sign_csrf
AEVO_SESSION_IDLE_TIMEOUT_SECONDS=1800
AEVO_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
# Short-lived in-process authorization snapshots. Core invalidates them on
# session, assignment, membership, role, entitlement, and scope writes.
AEVO_SESSION_SNAPSHOT_TTL_SECONDS=60
AEVO_ACCESS_SNAPSHOT_TTL_SECONDS=60
# Session touch writes are throttled separately from snapshot reads.
AEVO_SESSION_TOUCH_INTERVAL_SECONDS=30
# Optional persistent-cookie policy for an explicit "remember this device"
# choice. Core clamps these values to a maximum of 30 days.
AEVO_REMEMBERED_SESSION_IDLE_TIMEOUT_SECONDS=604800
AEVO_REMEMBERED_SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000
AEVO_ORIGIN_SIGNING_SECRET=
AEVO_FEED_CURSOR_SECRET=replace-with-a-long-random-feed-cursor-secret
AEVO_FEED_EVENT_WORKER_TOKEN=replace-with-a-separate-feed-event-worker-token
AEVO_REQUIRE_GATEWAY_SIGNATURE=false
AEVO_TRUSTED_GATEWAYS=aevo-edge-gateway
AEVO_CONNECTION_PROBE_TOKEN=
AEVO_HANDSHAKE_SHARED_SECRET=replace-with-a-long-random-handshake-secret
